# ============================================================
# .env.example — Root-level Docker Compose environment
# ============================================================
# Copy thành .env (dev) hoặc .env.prod (production)
# ⚠️  KHÔNG commit file .env thật vào git
# ============================================================

# ── Database (PostgreSQL) ───────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=skinaid_db
DB_USER=skinaid_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DATABASE_URL=postgresql+asyncpg://skinaid_user:CHANGE_ME@postgres:5432/skinaid_db

# ── Auth / JWT ──────────────────────────────────────────────
SECRET_KEY=CHANGE_ME_MIN_32_CHARS_RANDOM_STRING
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS & URLs ─────────────────────────────────────────────
CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
BASE_URL=https://yourdomain.com

# ── Frontend build args (used in docker-compose.prod.yml) ───
VITE_API_URL=https://yourdomain.com/api/v1
VITE_BACKEND_URL=https://yourdomain.com

# ── AI Service (Docker internal DNS) ────────────────────────
AI_SERVICE_URL=http://ai_ml:8001
AI_API_KEY=CHANGE_ME_INTERNAL_KEY
AI_SERVICE_TIMEOUT=30
AI_MAX_RETRIES=3

# ── Redis (Docker internal DNS) ─────────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=

# ── Qdrant (Docker internal DNS) ────────────────────────────
QDRANT=http://qdrant:6333/
RAG_COLLECTION_NAME=skinaid_knowledge_base
RAG_EMBEDDING_DIMENSION=3072
RAG_DOCS_PATH=docs/RAGDocumentation
RAG_SCORE_THRESHOLD=0.5
RAG_SPARSE_MODEL=Qdrant/bm25

# ── OpenAI API ──────────────────────────────────────────────
OPEN_API_KEY=CHANGE_ME_OPENAI_KEY
OPEN_EMBEDDING_MODEL=text-embedding-3-large
LLM_MODEL=gpt-4.1-mini
LLM_MAX_TOKENS=2000
LLM_TEMPERATURE=0.3
LLM_SYNTHESIS_TOP_K=5

# ── Email (Gmail SMTP) ──────────────────────────────────────
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME_EMAIL@gmail.com
SMTP_PASSWORD=CHANGE_ME_APP_PASSWORD
USE_MOCK_EMAIL=false

# ── Geoapify Map API ────────────────────────────────────────
GEOAPIFY_API_KEY=CHANGE_ME_GEOAPIFY_KEY

# ── App settings ────────────────────────────────────────────
APP_NAME=SkinAid Wound Detection API
VERSION=0.1.0
API_V1_STR=/api/v1
DEBUG=false
TESTING=false

# ── Upload config ───────────────────────────────────────────
MAX_UPLOAD_SIZE=5242880
ALLOWED_EXTENSIONS=.jpg,.jpeg,.png
UPLOAD_DIR=./uploads