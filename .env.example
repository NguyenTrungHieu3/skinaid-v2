# ===========================================
# SkinAid Docker Compose Environment Variables
# ===========================================
# Copy file này thành .env và điền các giá trị thực tế

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_NAME=skinaid_db

# ===========================================
# JWT & SECURITY
# ===========================================
SECRET_KEY=your-very-long-and-secure-secret-key-at-least-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===========================================
# EMAIL CONFIGURATION
# ===========================================
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
USE_MOCK_EMAIL=false

# ===========================================
# AI SERVICE (Hugging Face)
# ===========================================
# URL của AI service đã deploy trên Hugging Face
AI_SERVICE_URL=https://your-huggingface-space-url.hf.space
AI_API_KEY=your_ai_api_key_if_needed
AI_SERVICE_TIMEOUT=30
AI_MAX_RETRIES=3

# ===========================================
# APPLICATION SETTINGS
# ===========================================
DEBUG=false
TESTING=false

# ===========================================
# CORS ORIGINS
# ===========================================
# Danh sách các domain được phép truy cập API (phân cách bằng dấu phẩy)
CORS_ORIGINS=http://localhost:3000,https://your-domain.com

# ===========================================
# BASE URL
# ===========================================
# URL gốc của backend (dùng cho email links, etc.)
BASE_URL=https://your-backend-domain.com

# ===========================================
# GEOAPIFY (Map Service)
# ===========================================
GEOAPIFY_API_KEY=your_geoapify_api_key
