# ============================================
# DATABASE CONFIGURATION
# ============================================
DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/skinaid_db_ver2
DB_HOST=localhost
DB_PORT=5432
DB_NAME=skinaid_db_ver2
DB_USER=postgres
DB_PASSWORD=your_secure_password

# ============================================
# AI SERVICE CONFIGURATION
# ============================================
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_TIMEOUT=30
AI_MAX_RETRIES=3
AI_API_KEY=your-ai-service-api-key-here

# ============================================
# JWT SECURITY & AUTHENTICATION
# ============================================
SECRET_KEY=your-secret-key-here-change-this-in-production-32-chars-minimum
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================
# APPLICATION SETTINGS
# ============================================
APP_NAME=SkinAid Wound Detection API
VERSION=0.1.0
DEBUG=true
TESTING=false
API_V1_STR=/api/v1

# ============================================
# CORS CONFIGURATION
# ============================================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

# ============================================
# EMAIL CONFIGURATION (Gmail SMTP)
# ============================================
USE_MOCK_EMAIL=true
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# ============================================
# FILE UPLOAD CONFIGURATION
# ============================================
MAX_UPLOAD_SIZE=5242880
MIN_FILE_SIZE=1024
ALLOWED_EXTENSIONS=.jpg,.jpeg,.png
UPLOAD_DIR=./uploads
MAX_IMAGE_WIDTH=4096
MAX_IMAGE_HEIGHT=4096
MIN_IMAGE_WIDTH=100
MIN_IMAGE_HEIGHT=100

# ============================================
# EXTERNAL SERVICES & KEYS
# ============================================
GEOAPIFY_API_KEY=your-geoapify-api-key-here

# ============================================
# REDIS CONFIGURATION
# ============================================
REDIS_URL=redis://localhost:6379/0

# ============================================
# QDRANT VECTOR DATABASE (RAG)
# ============================================
QDRANT=http://localhost:6333/
RAG_COLLECTION_NAME=skinaid_knowledge_base
RAG_EMBEDDING_DIMENSION=3072
RAG_DOCS_PATH=docs/RAGDocumentation
RAG_SCORE_THRESHOLD=0.5
RAG_SPARSE_MODEL=Qdrant/bm25

# ============================================
# OPENAI CONFIGURATION (RAG embeddings & LLM)
# ============================================
OPEN_API_KEY=sk-your-openai-api-key-here
OPEN_EMBEDDING_MODEL=text-embedding-3-small
