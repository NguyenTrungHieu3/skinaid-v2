
DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/skinaid_db

# JWT Security
SECRET_KEY=your-secret-key-here-at-least-32-characters-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Email Configuration (Gmail SMTP)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Application Settings
DEBUG=true
APP_NAME=SkinAid Wound Detection API
VERSION=0.1.0

# Upload Configuration
UPLOAD_MAX_FILE_SIZE=5242880
UPLOAD_ALLOWED_FORMATS=.jpg,.jpeg,.png
UPLOAD_MIN_WIDTH=224
UPLOAD_MIN_HEIGHT=224
UPLOAD_DIR=uploads

USE_MOCK_EMAIL=false


TESTING=false

DEBUG=true


TESTING=false

# Application Information
APP_NAME=SkinAid Wound Detection API
VERSION=0.1.0
API_V1_STR=/api/v1

DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/skinaid_db


SECRET_KEY=your-secret-key-here-change-this-in-production-32-chars-minimum

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7


MAX_UPLOAD_SIZE=5242880

ALLOWED_EXTENSIONS=.jpg,.jpeg,.png

UPLOAD_DIR=./uploads


SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

FROM_EMAIL=noreply@skinaid.com
FROM_NAME=SkinAid Team

DB_HOST=localhost
DB_PORT=5432
DB_NAME=skinaid_db
DB_USER=username
DB_PASSWORD=password

LOG_LEVEL=INFO

LOG_FILE=./logs/app.log

# Redis
REDIS_URL=redis://localhost:6379/0

# OpenAI (RAG embeddings + LLM synthesis)
OPEN_API_KEY=sk-your-openai-api-key-here
OPEN_EMBEDDING_MODEL=text-embedding-3-large

# LLM Synthesis (B5 pipeline)
LLM_MODEL=gpt-4.1-mini
LLM_MAX_TOKENS=2000
LLM_TEMPERATURE=0.3
LLM_SYNTHESIS_TOP_K=5
