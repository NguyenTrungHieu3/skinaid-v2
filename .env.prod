# Copy file này thành .env.prod rồi điền giá trị thật
# TUYỆT ĐỐI KHÔNG commit file .env.prod lên git

# --- Database (RDS PostgreSQL) ---
DB_HOST=your-rds-endpoint.ap-southeast-1.rds.amazonaws.com
DB_USER=skinaid_user
DB_PASSWORD=your_strong_password_here
DB_NAME=skinaid_db

# --- JWT & Security ---
# Tạo SECRET_KEY bằng lệnh: openssl rand -hex 32
SECRET_KEY=paste_generated_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Email ---
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your@gmail.com
SMTP_PASSWORD=your_gmail_app_password
USE_MOCK_EMAIL=false

# --- AI Service (Hugging Face) ---
AI_SERVICE_URL=https://your-space.hf.space
AI_API_KEY=hf_xxxxxxxxxxxxxxxxxxxx
AI_SERVICE_TIMEOUT=30
AI_MAX_RETRIES=3

# --- CORS ---
# Thêm IP EC2 và localhost cho dev mobile
CORS_ORIGINS=http://YOUR_EC2_IP,http://localhost:8081,http://localhost:3000

# --- Base URL ---
BASE_URL=http://YOUR_EC2_IP

# --- Geoapify ---
GEOAPIFY_API_KEY=your_geoapify_key
