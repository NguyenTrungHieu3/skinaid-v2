# ============================================================
# SkinAid Frontend — Environment Variables Example
# ============================================================
# Copy file này thành .env.production (hoặc .env.development)
# và điền giá trị thật.
# File .env.example là file DUY NHẤT được commit vào git.
# ============================================================

# URL đầy đủ tới backend API (kết thúc bằng /api/v1)
VITE_API_URL=https://yourdomain.com/api/v1

# Base URL backend không có /api/v1 — dùng cho static files (ảnh, uploads)
VITE_BACKEND_URL=https://yourdomain.com
