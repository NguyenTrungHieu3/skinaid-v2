# AI/ML specific - Ignore large model files but track folder structure
models/*.pkl
models/*.pickle
models/*.joblib
models/*.h5
models/*.hdf5
models/*.pt
models/*.pth
models/*.onnx
models/*.tflite
models/*.bin
models/*.safetensors
models/*.tar.gz
models/*.zip

# Allow model metadata and configuration files
!models/*.json
!models/*.yaml
!models/*.yml
!models/*.txt
!models/*.md
!models/README*
!models/.gitkeep

