# Tự động normalize line endings cho tất cả file text
* text=auto

# Với file code, luôn dùng LF trong repo
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
# Windows batch giữ CRLF
*.bat text eol=crlf
# Binary files - không tự động đổi line endings
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.exe binary
*.dll binary
*.py text eol=lf
*.pth filter=lfs diff=lfs merge=lfs -text
