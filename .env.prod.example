# ============================================
# Copy file này thành .env.prod rồi điền giá trị thật
# TUYỆT ĐỐI KHÔNG commit file .env.prod lên git
# ============================================

# ============================================
# DATABASE (RDS PostgreSQL)
# ============================================
DB_HOST=your-rds-endpoint.ap-southeast-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=skinaid_db
DB_USER=skinaid_user
DB_PASSWORD=your_strong_password
DATABASE_URL=postgresql+asyncpg://skinaid_user:your_strong_password@your-rds-endpoint.ap-southeast-1.rds.amazonaws.com:5432/skinaid_db

# ============================================
# JWT & SECURITY
# Tạo SECRET_KEY bằng lệnh: openssl rand -hex 32
# ============================================
SECRET_KEY=paste_generated_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================
# APPLICATION
# ============================================
APP_NAME=SkinAid Wound Detection API
VERSION=0.1.0
DEBUG=false
TESTING=false
API_V1_STR=/api/v1
UPLOAD_DIR=/app/uploads

# ============================================
# CORS
# ============================================
CORS_ORIGINS=http://YOUR_ELASTIC_IP,http://localhost:8081,http://localhost:3000
BASE_URL=http://YOUR_ELASTIC_IP

# ============================================
# EMAIL (Gmail SMTP)
# ============================================
USE_MOCK_EMAIL=false
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password

# ============================================
# FILE UPLOAD
# ============================================
MAX_UPLOAD_SIZE=5242880
MIN_FILE_SIZE=1024
ALLOWED_EXTENSIONS=.jpg,.jpeg,.png
MAX_IMAGE_WIDTH=4096
MAX_IMAGE_HEIGHT=4096
MIN_IMAGE_WIDTH=100
MIN_IMAGE_HEIGHT=100

# ============================================
# AI SERVICE (nội bộ Docker — không đổi)
# Tạo AI_SECRET_KEY bằng lệnh: openssl rand -hex 32
# ============================================
AI_SERVICE_URL=http://ai:8001
AI_SECRET_KEY=paste_generated_key_here
AI_SERVICE_TIMEOUT=60
AI_MAX_RETRIES=3
S3_BUCKET=skinaid-models

# ============================================
# REDIS (nội bộ Docker — không đổi)
# ============================================
REDIS_URL=redis://redis:6379/0

# ============================================
# QDRANT (nội bộ Docker — không đổi)
# ============================================
QDRANT=http://qdrant:6333/
RAG_COLLECTION_NAME=skinaid_knowledge_base
RAG_EMBEDDING_DIMENSION=3072
RAG_DOCS_PATH=docs/RAGDocumentation
RAG_SCORE_THRESHOLD=0.5
RAG_SPARSE_MODEL=Qdrant/bm25

# ============================================
# OPENAI (RAG embeddings & LLM)
# ============================================
OPEN_API_KEY=sk-your-openai-api-key-here
OPEN_EMBEDDING_MODEL=text-embedding-3-small

# ============================================
# EXTERNAL SERVICES
# ============================================
GEOAPIFY_API_KEY=your-geoapify-api-key-here
