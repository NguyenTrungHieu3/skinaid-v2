# Copy file này thành .env.prod rồi điền giá trị thật
# TUYỆT ĐỐI KHÔNG commit file .env.prod lên git

# ============================================
# DATABASE (RDS PostgreSQL)
# ============================================
DB_HOST=your-rds-endpoint.ap-southeast-1.rds.amazonaws.com
DB_USER=skinaid_user
DB_PASSWORD=your_strong_password_here
DB_NAME=skinaid_db

# ============================================
# JWT & SECURITY
# ============================================
# Tạo bằng lệnh: openssl rand -hex 32
SECRET_KEY=paste_generated_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================
# EMAIL (Gmail)
# ============================================
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your@gmail.com
SMTP_PASSWORD=your_gmail_app_password
USE_MOCK_EMAIL=false

# ============================================
# AI SERVICE (Hugging Face)
# ============================================
AI_SERVICE_URL=https://your-space.hf.space
AI_API_KEY=hf_xxxxxxxxxxxxxxxxxxxx
AI_SERVICE_TIMEOUT=30
AI_MAX_RETRIES=3

# ============================================
# APPLICATION
# ============================================
MAX_UPLOAD_SIZE=5242880
MIN_FILE_SIZE=1024
ALLOWED_EXTENSIONS=.jpg,.jpeg,.png

# ============================================
# CORS & BASE URL
# ============================================
CORS_ORIGINS=http://YOUR_EC2_IP,http://localhost:8081,http://localhost:3000
BASE_URL=http://YOUR_EC2_IP

# ============================================
# GEOAPIFY
# ============================================
GEOAPIFY_API_KEY=your_geoapify_key

# ============================================
# REDIS (tự động trỏ về container — không đổi)
# ============================================
REDIS_URL=redis://redis:6379/0

# ============================================
# QDRANT VECTOR DATABASE (tự động trỏ về container — không đổi)
# ============================================
QDRANT=http://qdrant:6333/
RAG_COLLECTION_NAME=skinaid_knowledge_base
RAG_EMBEDDING_DIMENSION=3072
RAG_DOCS_PATH=docs/RAGDocumentation
RAG_SCORE_THRESHOLD=0.5
RAG_SPARSE_MODEL=Qdrant/bm25

# ============================================
# OPENAI (RAG embeddings & LLM)
# ============================================
OPEN_API_KEY=sk-your-openai-api-key-here
OPEN_EMBEDDING_MODEL=text-embedding-3-small
